<style>
/* Navigation Bar Styles */
/* Navigation Bar Styles - using nav element for accessibility */
nav.rpi-navbar {
    background-color: #333;
    margin-bottom: 20px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    min-height: 50px;
    /* The same space at both ends, whatever the last item is. */
    padding: 0 6px;
}

.rpi-navbar {
    background-color: #333;
    margin-bottom: 20px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    min-height: 50px;
}

.rpi-nav-items {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
}

.rpi-navbar a {
    color: white;
    text-align: center;
    padding: 12px 16px;
    text-decoration: none;
    font-size: 14px;
    transition: background-color 0.3s;
    white-space: nowrap;
    margin: 2px 1px;
    border-radius: 3px;
}

.rpi-navbar a:hover {
    background-color: #0066cc;
    color: white;
}

.rpi-navbar a.active {
    background-color: #0066cc;
    color: white;
}

.rpi-right-items {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    margin-left: auto;
}

.rpi-version-info {
    color: #ddd;
    font-size: 13px;
    padding: 12px 16px;
    white-space: nowrap;
}

.rpi-version-warning {
    color: #ffcc00;
    margin-left: 4px;
    font-size: 12px;
    font-weight: bold;
    text-shadow: 0 0 3px rgba(255, 204, 0, 0.5);
}

.rpi-version-link {
    text-decoration: none;
    color: inherit;
}

.rpi-version-link:hover {
    color: #ffcc00;
}

.rpi-github-link {
    margin-left: 5px;
}

.rpi-github-link:hover {
    background-color: #c51d4a !important;
    color: white;
}

.rpi-signout-form {
    display: inline;
    margin: 2px 1px;
}

.rpi-signout-button {
    background: transparent;
    color: white;
    border: 1px solid #777;
    border-radius: 3px;
    padding: 8px 12px;
    font-size: 13px;
    cursor: pointer;
}

.rpi-signout-button:hover {
    background-color: #0066cc;
}

/* Responsive adjustments */
@media (max-width: 1200px) {
    .rpi-navbar a {
        padding: 10px 12px;
        font-size: 13px;
    }
    
    .rpi-version-info {
        padding: 10px 12px;
    }
}

@media (max-width: 900px) {
    .rpi-navbar {
        flex-wrap: wrap;
    }
    
    .rpi-right-items {
        margin-left: 0;
        order: -1;
        margin-bottom: 5px;
        flex-wrap: wrap;
        /* A row of its own, so it wraps rather than overhanging the bar. */
        flex: 1 1 100%;
        min-width: 0;
    }
}
</style>

<!-- Skip to main content link for accessibility -->
<a href="#main-content" class="skip-link">Skip to main content</a>

<!-- Security Warning Banner for Public Binding -->
<%c++ extern bool g_isPublicBinding; %>
<%c++ extern std::string g_listenerAddress; %>
<%c++ if(g_isPublicBinding && !@@.get<bool>("anonymous")) { %>
<div class="security-warning-banner" role="alert">
    <span class="warning-icon" aria-hidden="true">⚠️</span>
    <div class="warning-content">
        <div class="warning-title">Security Warning: Public Network Binding Detected</div>
        <div class="warning-text">
            This provisioner is bound to <strong><%c++ $$ << HttpViewData::htmlTranslate(g_listenerAddress); %></strong> and may be accessible from external networks.
            Anyone who can reach it can try to sign in. Bind to 127.0.0.1 unless remote access is needed, and sign in remotely only over HTTPS.
        </div>
    </div>
</div>
<%c++ } %>

<!-- Encryption-at-rest Migration Banner -->
<!-- Reuses the same security-warning-banner component and server-side
     conditional pattern as the public-binding warning above. The condition is
     evaluated fresh on every render (cheap header reads), so the banner clears
     itself once the user has migrated. The consent controls live on the
     signing-key section of the Options page (#key-config-group). -->
<%c++ bool rpiHasUnwrappedSecretsAtRest(); %>
<%c++ if(!@@.get<bool>("anonymous") && rpiHasUnwrappedSecretsAtRest()) { %>
<div class="security-warning-banner" role="alert">
    <span class="warning-icon" aria-hidden="true">⚠️</span>
    <div class="warning-content">
        <div class="warning-title">Secrets Stored Unencrypted at Rest</div>
        <div class="warning-text">
            One or more secrets on this server (the HSM PIN and/or the signing key) are stored unencrypted.
            <a href="/options/get#key-config-group">Review and encrypt them &rarr;</a>
        </div>
    </div>
</div>
<%c++ } %>

<!-- Navigation Bar -->
<nav class="rpi-navbar" role="navigation" aria-label="Main navigation">
    <div class="rpi-nav-items">
        <a href="/devices" <%c++ if(@@.get<std::string>("currentPage") == "devices") { %>class="active" aria-current="page"<%c++ } %>>Devices</a>
        <a href="/options/get" <%c++ if(@@.get<std::string>("currentPage") == "options") { %>class="active" aria-current="page"<%c++ } %>>Options</a>
        <a href="/customisation/list-scripts" <%c++ if(@@.get<std::string>("currentPage") == "customisation") { %>class="active" aria-current="page"<%c++ } %>>Customisation</a>
        <a href="/services" <%c++ if(@@.get<std::string>("currentPage") == "services") { %>class="active" aria-current="page"<%c++ } %>>Services</a>
        <a href="/manu-db" <%c++ if(@@.get<std::string>("currentPage") == "manufacturing") { %>class="active" aria-current="page"<%c++ } %>>Manufacturing Database</a>
        <a href="/auditlog" <%c++ if(@@.get<std::string>("currentPage") == "auditlog") { %>class="active" aria-current="page"<%c++ } %>>Audit Log</a>
        <a href="/scantool" id="rpi-nav-scantool" <%c++ if(@@.get<std::string>("currentPage") == "scantool") { %>class="active" aria-current="page"<%c++ } %>>Code Scanner</a>
        <script>
        // Browsers give the camera only to a secure context -- HTTPS, or this
        // machine -- and the scanner has nothing else, so elsewhere it is hidden.
        if (!window.isSecureContext) {
            var scan = document.getElementById('rpi-nav-scantool');
            if (scan && !scan.classList.contains('active')) scan.hidden = true;
        }
        </script>
    </div>
    
    <div class="rpi-right-items">
        <span class="rpi-version-info">
            <%c++ extern std::string g_packageVersion; %>
            <%c++ extern bool g_hasNewerVersion; %>
            <%c++ extern std::string g_releaseUrl; %>
            
            <%c++ if(g_hasNewerVersion && !g_releaseUrl.empty()) { %>
                <a href="<%c++ $$ << HttpViewData::htmlTranslate(g_releaseUrl); %>" target="_blank" class="rpi-version-link">
                    v<%c++ $$ << HttpViewData::htmlTranslate(g_packageVersion); %>
                    <span class="rpi-version-warning" aria-label="Update available">⚠</span>
                </a>
            <%c++ } else { %>
                v<%c++ $$ << HttpViewData::htmlTranslate(g_packageVersion); %>
            <%c++ } %>
        </span>
        <a href="https://github.com/raspberrypi/rpi-sb-provisioner" target="_blank" class="rpi-github-link">GitHub</a>
        <%c++ if (@@.get<bool>("anonymous")) { %>
        <%c++ /* The dashboard and scanner can be viewed without signing in. */ %>
        <%c++ if (@@.get<std::string>("currentPage") != "login") { %>
        <a href="/login" id="rpi-sign-in">Sign in</a>
        <%c++ } %>
        <script>
        (function () {
            var a = document.getElementById('rpi-sign-in');
            if (a) a.href = '/login?next=' + encodeURIComponent(location.pathname + location.search);
        })();
        </script>
        <%c++ } else { %>
        <a href="/auth/tokens" id="rpi-signed-in-user" title="API tokens" <%c++ if(@@.get<std::string>("currentPage") == "tokens") { %>class="active" aria-current="page"<%c++ } %>></a>
        <form method="post" action="/logout" class="rpi-signout-form" id="rpi-signout-form">
            <input type="hidden" name="next" id="rpi-signout-next">
            <button type="submit" class="rpi-signout-button">Sign out</button>
        </form>
        <script>
        document.getElementById('rpi-signout-next').value = location.pathname + location.search;
        </script>
        <%c++ } %>
    </div>
</nav>
<script>
// Every state-changing request must carry the session's CSRF token. Attach it
// here, once, so no page can forget: fetch, XMLHttpRequest and plain forms.
(function () {
    if (window.__rpiCsrfInstalled) return;
    window.__rpiCsrfInstalled = true;

    function token() {
        var m = document.cookie.match(/(?:^|;\s*)rpi_sb_csrf=([^;]*)/);
        return m ? decodeURIComponent(m[1]) : '';
    }
    function sameOrigin(url) {
        try { return new URL(url, location.href).origin === location.origin; } catch (e) { return false; }
    }
    function changesState(method) {
        method = (method || 'GET').toUpperCase();
        return method !== 'GET' && method !== 'HEAD';
    }

    var originalFetch = window.fetch;
    window.fetch = function (input, init) {
        var url = input instanceof Request ? input.url : String(input);
        var method = (init && init.method) || (input instanceof Request ? input.method : 'GET');
        if (changesState(method) && sameOrigin(url)) {
            init = Object.assign({}, init);
            var headers = new Headers(init.headers || (input instanceof Request ? input.headers : undefined));
            if (!headers.has('X-CSRF-Token')) headers.set('X-CSRF-Token', token());
            init.headers = headers;
        }
        return originalFetch.call(this, input, init);
    };

    var open = XMLHttpRequest.prototype.open;
    var setHeader = XMLHttpRequest.prototype.setRequestHeader;
    var send = XMLHttpRequest.prototype.send;
    XMLHttpRequest.prototype.open = function (method, url) {
        this.__rpiNeedsCsrf = changesState(method) && sameOrigin(url);
        return open.apply(this, arguments);
    };
    XMLHttpRequest.prototype.setRequestHeader = function (name, value) {
        if (String(name).toLowerCase() === 'x-csrf-token') this.__rpiNeedsCsrf = false;
        return setHeader.apply(this, arguments);
    };
    XMLHttpRequest.prototype.send = function () {
        if (this.__rpiNeedsCsrf) setHeader.call(this, 'X-CSRF-Token', token());
        return send.apply(this, arguments);
    };

    // A multipart body is not visible to the server's gate, so forms carry the
    // token in the query string instead.
    document.addEventListener('submit', function (event) {
        var form = event.target;
        if (!(form instanceof HTMLFormElement) || !changesState(form.method) || !sameOrigin(form.action)) return;
        var url = new URL(form.action, location.href);
        url.searchParams.set('_csrf_token', token());
        form.action = url.toString();
    }, true);

    fetch('/auth/session', { headers: { 'Accept': 'application/json' } })
        .then(function (r) { return r.ok ? r.json() : null; })
        .then(function (s) {
            var el = document.getElementById('rpi-signed-in-user');
            if (s && s.user && el) el.textContent = s.user;
        })
        .catch(function () {});
})();
</script>
<%view-end%> 