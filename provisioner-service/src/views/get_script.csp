<%inc
#include <string>
#include <vector>
#include <json/json.h>
%>

<%c++ 
// Initialize with defaults
std::string script_name = "";
bool script_exists = false;
bool script_enabled = false;
std::string script_content = "";
std::string currentPage = "customisation";
Json::Value copy_sources(Json::arrayValue);

// Use try/catch to handle missing values
try {
    script_name = @@.get<std::string>("script_name");
} catch (...) {}

try {
    script_exists = @@.get<bool>("script_exists");
} catch (...) {}

try {
    script_enabled = @@.get<bool>("script_enabled");
} catch (...) {}

try {
    script_content = @@.get<std::string>("script_content");
} catch (...) {}

try {
    copy_sources = @@.get<Json::Value>("copy_sources");
} catch (...) {}
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Edit Customisation Script</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%view stylesheet %>
    <style>
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 15px;
        }
        
        .mt-4 {
            margin-top: 1.5rem;
        }

        /* Script editor styles */
        .script-editor-container {
            max-width: 1200px;
        }
        .custom-switch {
            padding-top: 7px;
        }
        pre {
            background-color: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
        }

        /* Basic Bootstrap replacements needed for this page */
        .row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -15px;
            margin-left: -15px;
        }
        
        .col-md-auto {
            position: relative;
            width: auto;
            padding-right: 15px;
            padding-left: 15px;
        }
        
        .mb-3 {
            margin-bottom: 1rem;
        }
        
        .d-flex {
            display: flex;
        }
        
        .justify-content-between {
            justify-content: space-between;
        }
        
        .btn {
            display: inline-block;
            font-weight: 400;
            text-align: center;
            white-space: nowrap;
            vertical-align: middle;
            user-select: none;
            border: 1px solid transparent;
            padding: 0.375rem 0.75rem;
            font-size: 1rem;
            line-height: 1.5;
            border-radius: 0.25rem;
            transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            cursor: pointer;
        }
        
        /* Button styles now centralized in stylesheet.csp */

        /* Modal styling */
        .modal {
            display: none;
            position: fixed;
            z-index: 1050;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
        }
        
        .modal-dialog {
            position: relative;
            width: auto;
            margin: 0.5rem;
            pointer-events: none;
            max-width: 800px;
            margin: 1.75rem auto;
        }
        
        .modal-content {
            position: relative;
            display: flex;
            flex-direction: column;
            width: 100%;
            pointer-events: auto;
            background-color: #fff;
            background-clip: padding-box;
            border: 1px solid rgba(0,0,0,0.2);
            border-radius: 0.3rem;
            outline: 0;
        }
        
        .modal-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            padding: 1rem;
            border-bottom: 1px solid #e9ecef;
            border-top-left-radius: 0.3rem;
            border-top-right-radius: 0.3rem;
        }
        
        .modal-title {
            margin-bottom: 0;
            line-height: 1.5;
            font-size: 1.25rem;
        }
        
        .close {
            float: right;
            font-size: 1.5rem;
            font-weight: 700;
            line-height: 1;
            color: #000;
            text-shadow: 0 1px 0 #fff;
            opacity: .5;
            padding: 0;
            background-color: transparent;
            border: 0;
            appearance: none;
        }
        
        .modal-body {
            position: relative;
            flex: 1 1 auto;
            padding: 1rem;
        }
        
        .modal-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 1rem;
            border-top: 1px solid #e9ecef;
        }
        
        .fade {
            opacity: 0;
            transition: opacity 0.15s linear;
        }
        
        .fade.show {
            opacity: 1;
        }

        .custom-control {
            position: relative;
            display: block;
            min-height: 1.5rem;
        }
        
        .toggle-btn {
            padding: 8px 16px;
            border-radius: 4px;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        
        .toggle-btn.enabled {
            background-color: #1e7e34;
            color: white;
            border: 1px solid #1e7e34;
        }
        
        .toggle-btn.disabled {
            background-color: #f8f9fa;
            color: #5c636a;
            border: 1px solid #ced4da;
        }

        .script-status-note {
            background-color: #f8f9fa;
            padding: 10px 15px;
            border-left: 4px solid #5c636a;
            margin-bottom: 1rem;
            color: #495057;
            font-style: italic;
        }

        /* Copy-from dropdown */
        .copy-from-wrapper {
            position: relative;
            display: inline-block;
        }

        .copy-from-menu {
            display: none;
            position: absolute;
            bottom: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            min-width: 200px;
            z-index: 100;
            margin-bottom: 4px;
        }

        .copy-from-menu.open {
            display: block;
        }

        .copy-from-menu a {
            display: block;
            padding: 8px 14px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
        }

        .copy-from-menu a:hover {
            background-color: #f0f0f0;
        }
        /* Monokai's line numbers are too faint to read against its gutter. */
        .ace-monokai .ace_gutter { color: #b8b9b2; }
    </style>
</head>
<body>
    <%view navbar %>
    
    <main id="main-content">
    <div class="container mt-4">
        <div class="container script-editor-container">
            <a href="/customisation/list-scripts" class="mb-3 d-inline-block"><span aria-hidden="true">&larr;</span> Back to Scripts</a>
            <h2>Script Editor - <span id="script-filename"><%c++ $$ << HttpViewData::htmlTranslate(script_name); %></span></h2>
            
            <div class="row mb-3">
                <div class="col-md-auto">
                    <p class="script-status-note">
                        To enable or disable this script, use the controls on the scripts list page.
                        In the editor, press Enter to start editing and Escape to leave it.
                    </p>
                </div>
            </div>

            <%c++ /* The textarea is the editor if Ace cannot start; Ace replaces it
                     when it does. */ %>
            <div id="ace-editor" hidden style="height: 500px; width: 100%; border: 1px solid #ddd;"></div>
            <textarea id="editor" spellcheck="false" autocapitalize="off" aria-label="Script contents"
                      style="height: 500px; width: 100%; box-sizing: border-box; border: 1px solid #ddd; padding: 8px;
                             font: 14px/1.4 ui-monospace, 'DejaVu Sans Mono', monospace; tab-size: 4; white-space: pre;"
            ><%c++ $$ << HttpViewData::htmlTranslate(script_content); %></textarea>

            <div class="mt-3 d-flex justify-content-between">
                <button id="save-btn" class="btn btn-success">Save</button>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <%c++ if (copy_sources.size() > 0) { %>
                    <div class="copy-from-wrapper">
                        <button id="copy-from-btn" class="btn btn-secondary" type="button">
                            Copy from&hellip;
                        </button>
                        <div id="copy-from-menu" class="copy-from-menu">
                            <%c++ for (Json::ArrayIndex i = 0; i < copy_sources.size(); i++) { %>
                            <a href="#" class="copy-from-item"
                               data-source="<%c++ $$ << HttpViewData::htmlTranslate(copy_sources[i]["filename"].asString()); %>"
                               data-provisioner="<%c++ $$ << HttpViewData::htmlTranslate(copy_sources[i]["provisioner"].asString()); %>">
                                <%c++ $$ << HttpViewData::htmlTranslate(copy_sources[i]["provisioner"].asString()); %>
                            </a>
                            <%c++ } %>
                        </div>
                    </div>
                    <%c++ } %>
                    <button id="script-help-btn" class="btn btn-info">
                        Help
                    </button>
                </div>
            </div>

            <!-- Help Modal -->
            <div class="modal fade" id="helpModal" tabindex="-1" role="dialog" aria-labelledby="helpModalTitle" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="helpModalTitle">Script Helper</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body">
                            <h6>About Customisation Scripts</h6>
                            <p>
                                Customisation scripts allow you to add custom operations at specific points in the provisioning process. 
                                These scripts run at predetermined stages in each provisioner's workflow.
                            </p>
                            
                            <h6>Script Arguments</h6>
                            <p>Different stages receive different arguments, appropriate to their position in the provisioning process:</p>
                            <ul>
                                <li><code>bootfs, rootfs</code></li>
                                <ul>
                                    <li><code>$1</code>: The fastboot device specifier. You must always use this when you use fastboot: <code>fastboot -s ${1}</code></li>
                                    <li><code>$2</code>: The device serial number, also obtainable via <code>fastboot getvar serialno</code></li>
                                    <li><code>$2</code>: Selected storage device</li>
                                </ul>
                                <li><code>post-flash</code></li>
                                <ul>
                                    <li><code>$1</code>: Bootfs mount point.</li>
                                    <li><code>$2</code>: Root filesystem mount point.</li>
                                </ul>
                            </ul>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script src="/static/js/ace/ace.js"></script>
<script>
    // Ace is vendored under /static/js/ace, and nothing else is needed: the
    // page used to fetch jQuery, Ace and Font Awesome from public CDNs, so a
    // station off the internet had no editor, and code from elsewhere ran
    // with the operator's session.
    (function () {
        var area = document.getElementById('editor');
        var editor = { getValue: function () { return area.value; },
                       setValue: function (v) { area.value = v; } };
        if (window.ace) {
            ace.config.set('basePath', '/static/js/ace');
            var ed = ace.edit('ace-editor');
            ed.setTheme('ace/theme/monokai');
            ed.session.setMode('ace/mode/sh');
            // Otherwise Tab indents and never leaves: keyboard users could
            // not reach Save. Enter starts editing and Escape leaves.
            ed.setOption('enableKeyboardAccessibility', true);
            ed.setFontSize(14);
            ed.setValue(area.value, -1);
            document.getElementById('ace-editor').hidden = false;
            area.hidden = true;
            editor = { getValue: function () { return ed.getValue(); },
                       setValue: function (v) { ed.setValue(v, -1); } };
        }
        window.scriptEditor = editor;

        var scriptName = document.getElementById('script-filename').textContent;
        var scriptExists = <%c++ $$ << (script_exists ? "true" : "false"); %>;
        var activeTab = new URLSearchParams(location.search).get('activeTab') || '';
        var listUrl = '/customisation/list-scripts' +
            (activeTab ? '?activeTab=' + encodeURIComponent(activeTab) : '');

        var modal = document.getElementById('helpModal');
        function showHelp(show) {
            modal.style.display = show ? 'block' : 'none';
            modal.classList.toggle('show', show);
        }
        document.getElementById('script-help-btn').addEventListener('click', function () { showHelp(true); });
        document.querySelectorAll(".close, .btn[data-dismiss='modal']").forEach(function (b) {
            b.addEventListener('click', function () { showHelp(false); });
        });

        document.querySelectorAll("a[href='/customisation/list-scripts']").forEach(function (a) {
            a.href = listUrl;
        });

        var copyBtn = document.getElementById('copy-from-btn');
        var copyMenu = document.getElementById('copy-from-menu');
        if (copyBtn && copyMenu) {
            copyBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                copyMenu.classList.toggle('open');
            });
            document.addEventListener('click', function () { copyMenu.classList.remove('open'); });
            copyMenu.addEventListener('click', function (e) { e.stopPropagation(); });
            copyMenu.querySelectorAll('.copy-from-item').forEach(function (item) {
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    copyMenu.classList.remove('open');
                    var source = item.dataset.source;
                    var provisioner = item.dataset.provisioner;
                    if (!confirm("Replace current editor contents with the script from " + provisioner +
                                 "? Any unsaved changes will be lost.")) {
                        return;
                    }
                    fetch('/customisation/get-script?script=' + encodeURIComponent(source),
                          { headers: { 'Accept': 'application/json' } })
                        .then(function (r) {
                            return r.json().catch(function () { return {}; }).then(function (body) {
                                if (!r.ok) throw new Error(body.error || ('HTTP ' + r.status));
                                return body;
                            });
                        })
                        .then(function (body) {
                            if (body.content === undefined) {
                                alert("Failed to load script from " + provisioner + ": unexpected response format.");
                                return;
                            }
                            editor.setValue(body.content);
                        })
                        .catch(function (err) {
                            alert("Failed to load script from " + provisioner + ". " + err.message);
                        });
                });
            });
        }

        document.getElementById('save-btn').addEventListener('click', function () {
            var content = editor.getValue();
            if (!scriptExists && content.trim() === '') {
                content = '#!/bin/bash\n\n# Script arguments:\n# $1 - The provisioner ID (e.g., "raspios_lite_arm64")\n# $2 - The stage name (e.g., "post-flash", "rootfs-mounted")\n# $3 - The log file path (append output here with >> "$3")\n\n# Example: Modify a file in the rootfs\necho "[$1] Adding custom configuration to /etc/hosts during $2 stage" >> "$3"\n\n# Append a custom host entry to /etc/hosts in the rootfs\necho "10.0.0.100 custom-host" >> /mnt/rootfs/etc/hosts\n\n# Return success\nexit 0';
                editor.setValue(content);
            }
            var base = scriptName.endsWith('.sh') ? scriptName.slice(0, -3) : scriptName;
            fetch('/customisation/save-script', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ filename: base, content: content })
            }).then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                window.location.href = listUrl;
            }).catch(function () {
                alert("Failed to save script. Please try again.");
            });
        });
    })();
</script>
    </main>
</body>
</html> 