<%inc
#include <string>
#include <vector>
#include <json/json.h>
%>

<%c++ 
// Initialize with defaults
std::string script_name = "";
bool script_exists = false;
bool script_enabled = false;
std::string script_content = "";
std::string currentPage = "customisation";
Json::Value copy_sources(Json::arrayValue);

// Use try/catch to handle missing values
try {
    script_name = @@.get<std::string>("script_name");
} catch (...) {}

try {
    script_exists = @@.get<bool>("script_exists");
} catch (...) {}

try {
    script_enabled = @@.get<bool>("script_enabled");
} catch (...) {}

try {
    script_content = @@.get<std::string>("script_content");
} catch (...) {}

try {
    copy_sources = @@.get<Json::Value>("copy_sources");
} catch (...) {}
%>

<!DOCTYPE html>
<html lang="en">
<head>
    <title>Edit Customisation Script</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <%view stylesheet %>
    <style>
        .container {
            max-width: 1200px;
            margin: 20px auto;
            padding: 0 15px;
        }
        
        .mt-4 {
            margin-top: 1.5rem;
        }

        /* Script editor styles */
        .script-editor-container {
            max-width: 1200px;
        }
        .custom-switch {
            padding-top: 7px;
        }
        pre {
            background-color: #f8f9fa;
            padding: 10px;
            border-radius: 5px;
        }

        /* Basic Bootstrap replacements needed for this page */
        .row {
            display: flex;
            flex-wrap: wrap;
            margin-right: -15px;
            margin-left: -15px;
        }
        
        .col-md-auto {
            position: relative;
            width: auto;
            padding-right: 15px;
            padding-left: 15px;
        }
        
        .mb-3 {
            margin-bottom: 1rem;
        }
        
        .d-flex {
            display: flex;
        }
        
        .justify-content-between {
            justify-content: space-between;
        }
        
        .btn {
            display: inline-block;
            font-weight: 400;
            text-align: center;
            white-space: nowrap;
            vertical-align: middle;
            user-select: none;
            border: 1px solid transparent;
            padding: 0.375rem 0.75rem;
            font-size: 1rem;
            line-height: 1.5;
            border-radius: 0.25rem;
            transition: color 0.15s ease-in-out, background-color 0.15s ease-in-out, border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
            cursor: pointer;
        }
        
        /* Button styles now centralized in stylesheet.csp */

        /* Modal styling */
        .modal {
            display: none;
            position: fixed;
            z-index: 1050;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto;
            background-color: rgba(0,0,0,0.4);
        }
        
        .modal-dialog {
            position: relative;
            width: auto;
            margin: 0.5rem;
            pointer-events: none;
            max-width: 800px;
            margin: 1.75rem auto;
        }
        
        .modal-content {
            position: relative;
            display: flex;
            flex-direction: column;
            width: 100%;
            pointer-events: auto;
            background-color: #fff;
            background-clip: padding-box;
            border: 1px solid rgba(0,0,0,0.2);
            border-radius: 0.3rem;
            outline: 0;
        }
        
        .modal-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            padding: 1rem;
            border-bottom: 1px solid #e9ecef;
            border-top-left-radius: 0.3rem;
            border-top-right-radius: 0.3rem;
        }
        
        .modal-title {
            margin-bottom: 0;
            line-height: 1.5;
            font-size: 1.25rem;
        }
        
        .close {
            float: right;
            font-size: 1.5rem;
            font-weight: 700;
            line-height: 1;
            color: #000;
            text-shadow: 0 1px 0 #fff;
            opacity: .5;
            padding: 0;
            background-color: transparent;
            border: 0;
            appearance: none;
        }
        
        .modal-body {
            position: relative;
            flex: 1 1 auto;
            padding: 1rem;
        }
        
        .hook-help table { width: 100%; border-collapse: collapse; margin: 0 0 1rem; font-size: 0.9rem; }
        .hook-help th, .hook-help td { border-bottom: 1px solid #e9ecef; padding: 6px 8px; text-align: left; vertical-align: top; }
        .hook-help code { overflow-wrap: anywhere; }
        .hook-help tr.current { background: #e7f1ff; }
        .hook-help h6 { font-size: 1rem; margin: 1rem 0 0.5rem; }
        .hook-help details { margin-top: 1rem; }
        .hook-help summary { cursor: pointer; font-weight: 600; }
        .modal-body.hook-help { max-height: 70vh; overflow-y: auto; }

        .modal-footer {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 1rem;
            border-top: 1px solid #e9ecef;
        }
        
        .fade {
            opacity: 0;
            transition: opacity 0.15s linear;
        }
        
        .fade.show {
            opacity: 1;
        }

        .custom-control {
            position: relative;
            display: block;
            min-height: 1.5rem;
        }
        
        .toggle-btn {
            padding: 8px 16px;
            border-radius: 4px;
            font-weight: 500;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
        
        .toggle-btn.enabled {
            background-color: #1e7e34;
            color: white;
            border: 1px solid #1e7e34;
        }
        
        .toggle-btn.disabled {
            background-color: #f8f9fa;
            color: #5c636a;
            border: 1px solid #ced4da;
        }

        .script-status-note {
            background-color: #f8f9fa;
            padding: 10px 15px;
            border-left: 4px solid #5c636a;
            margin-bottom: 1rem;
            color: #495057;
            font-style: italic;
        }

        /* Copy-from dropdown */
        .copy-from-wrapper {
            position: relative;
            display: inline-block;
        }

        .copy-from-menu {
            display: none;
            position: absolute;
            bottom: 100%;
            left: 0;
            background: #fff;
            border: 1px solid #ccc;
            border-radius: 4px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            min-width: 200px;
            z-index: 100;
            margin-bottom: 4px;
        }

        .copy-from-menu.open {
            display: block;
        }

        .copy-from-menu a {
            display: block;
            padding: 8px 14px;
            color: #333;
            text-decoration: none;
            font-size: 14px;
        }

        .copy-from-menu a:hover {
            background-color: #f0f0f0;
        }
        /* Monokai's line numbers are too faint to read against its gutter. */
        .ace-monokai .ace_gutter { color: #b8b9b2; }
    </style>
</head>
<body>
    <%view navbar %>
    
    <main id="main-content">
    <div class="container mt-4">
        <div class="container script-editor-container">
            <a href="/customisation/list-scripts" class="mb-3 d-inline-block"><span aria-hidden="true">&larr;</span> Back to Scripts</a>
            <h2>Script Editor - <span id="script-filename"><%c++ $$ << HttpViewData::htmlTranslate(script_name); %></span></h2>
            
            <div class="row mb-3">
                <div class="col-md-auto">
                    <p class="script-status-note">
                        To enable or disable this script, use the controls on the scripts list page.
                        In the editor, press Enter to start editing and Escape to leave it.
                    </p>
                </div>
            </div>

            <%c++ /* The textarea is the editor if Ace cannot start; Ace replaces it
                     when it does. */ %>
            <div id="ace-editor" hidden style="height: 500px; width: 100%; border: 1px solid #ddd;"></div>
            <textarea id="editor" spellcheck="false" autocapitalize="off" aria-label="Script contents"
                      style="height: 500px; width: 100%; box-sizing: border-box; border: 1px solid #ddd; padding: 8px;
                             font: 14px/1.4 ui-monospace, 'DejaVu Sans Mono', monospace; tab-size: 4; white-space: pre;"
            ><%c++ $$ << HttpViewData::htmlTranslate(script_content); %></textarea>

            <div class="mt-3 d-flex justify-content-between">
                <button id="save-btn" class="btn btn-success">Save</button>
                <div style="display: flex; gap: 8px; align-items: center;">
                    <%c++ if (copy_sources.size() > 0) { %>
                    <div class="copy-from-wrapper">
                        <button id="copy-from-btn" class="btn btn-secondary" type="button">
                            Copy from&hellip;
                        </button>
                        <div id="copy-from-menu" class="copy-from-menu">
                            <%c++ for (Json::ArrayIndex i = 0; i < copy_sources.size(); i++) { %>
                            <a href="#" class="copy-from-item"
                               data-source="<%c++ $$ << HttpViewData::htmlTranslate(copy_sources[i]["filename"].asString()); %>"
                               data-provisioner="<%c++ $$ << HttpViewData::htmlTranslate(copy_sources[i]["provisioner"].asString()); %>">
                                <%c++ $$ << HttpViewData::htmlTranslate(copy_sources[i]["provisioner"].asString()); %>
                            </a>
                            <%c++ } %>
                        </div>
                    </div>
                    <%c++ } %>
                    <button id="script-help-btn" class="btn btn-info">
                        Help
                    </button>
                </div>
            </div>

            <!-- Help Modal -->
            <div class="modal fade" id="helpModal" tabindex="-1" role="dialog" aria-labelledby="helpModalTitle" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="helpModalTitle">Writing a hook</h5>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                <span aria-hidden="true">&times;</span>
                            </button>
                        </div>
                        <div class="modal-body hook-help">
                            <p id="hook-help-this">Hooks are shell scripts, run as root by the provisioner at fixed points in each device's run.</p>

                            <h6>Arguments, by stage</h6>
                            <table>
                                <thead><tr><th scope="col">Stage</th><th scope="col">When it runs</th><th scope="col">Arguments</th></tr></thead>
                                <tbody>
                                    <tr data-stage="bootstrap"><td><code>bootstrap</code></td><td>A device in RPIBOOT mode is found, before its EEPROM is updated. It has no fastboot yet. Not for IDP.</td><td><code>$1</code> serial, <code>$2</code> device family (USB product ID, e.g. <code>2712</code>), <code>$3</code> USB path, <code>$4</code> USB device node</td></tr>
                                    <tr data-stage="provision-started"><td><code>provision-started</code></td><td>The device is in fastboot and provisioning begins.</td><td><code>$1</code> fastboot specifier, <code>$2</code> serial, <code>$3</code> storage device (e.g. <code>mmcblk0</code>)</td></tr>
                                    <tr data-stage="bootfs-mounted"><td><code>bootfs-mounted</code></td><td>When the image is prepared, on this server. Once per image, not per device: whatever you change goes into every device. Clear the cache to run it again. Not for IDP.</td><td><code>$1</code> boot partition mount point, <code>$2</code> root partition mount point</td></tr>
                                    <tr data-stage="rootfs-mounted"><td><code>rootfs-mounted</code></td><td>Straight after <code>bootfs-mounted</code>, on the same mounts, with the same once-per-image rule. Not for IDP.</td><td><code>$1</code> boot partition mount point, <code>$2</code> root partition mount point</td></tr>
                                    <tr data-stage="post-flash"><td><code>post-flash</code></td><td>The device is written and its details recorded.</td><td><code>$1</code> fastboot specifier, <code>$2</code> serial, <code>$3</code> storage device; the device's record in the environment, below</td></tr>
                                    <tr data-stage="provision-failed"><td><code>provision-failed</code></td><td>Bootstrap, triage or provisioning stopped with an error.</td><td>After bootstrap: as <code>bootstrap</code>. Otherwise: as <code>provision-started</code>.</td></tr>
                                </tbody>
                            </table>

                            <h6>Environment, every stage</h6>
                            <table>
                                <tbody>
                                    <tr><td><code>TARGET_DEVICE_SERIAL</code></td><td>Device serial number</td></tr>
                                    <tr><td><code>TARGET_DEVICE_FAMILY</code></td><td>USB product ID of the SoC family; set in bootstrap</td></tr>
                                    <tr><td><code>TARGET_USB_PATH</code></td><td>USB port path, e.g. <code>1-1.2</code></td></tr>
                                    <tr><td><code>TARGET_DEVICE_PATH</code></td><td>USB device node, e.g. <code>/dev/bus/usb/001/004</code></td></tr>
                                    <tr><td><code>FASTBOOT_DEVICE_SPECIFIER</code></td><td>What to give <code>fastboot -s</code>, once the device is in fastboot</td></tr>
                                    <tr><td><code>RPI_DEVICE_STORAGE_TYPE</code></td><td>Storage device being written</td></tr>
                                </tbody>
                            </table>
                            <p><code>provision-failed</code> also has <code>PROVISION_FAILED_CONTEXT</code> (<code>bootstrap</code> or <code>provisioning</code>) and <code>PROVISION_FAILED_PERMANENT</code> (<code>1</code> if the device will not be retried).</p>
                            <p><code>post-flash</code> also has the device's manufacturing record: <code>BOARDNAME</code>, <code>SERIAL</code>, <code>ETH_MAC</code>, <code>WIFI_MAC</code>, <code>BT_MAC</code>, <code>MMC_SIZE</code>, <code>MMC_CID</code>, <code>RPI_DUID</code>, <code>BOARD_REVISION</code>, <code>PROCESSOR</code>, <code>MEMORY</code>, <code>MANUFACTURER</code>, <code>SECURE</code>, <code>JTAG_LOCKED</code>, <code>EEPROM_WRITE_PROTECTED</code>, <code>PUBKEY_PROGRAMMED</code>, <code>DEVKEY_REVOKED</code>, <code>SIGNED_BOOT_ENABLED</code>, <code>OS_IMAGE_FILENAME</code>, <code>OS_IMAGE_SHA256</code>, <code>CONNECT_REGISTERED</code>, <code>CONNECT_DEVICE_ID</code>, <code>EEPROM_SIZE</code>, <code>EEPROM_JEDEC</code>, <code>EEPROM_UNIQUE_ID</code>, <code>BOOTLOADER_BUILD_TIMESTAMP</code>, <code>CUSTOMER_KEY_FINGERPRINT</code>, <code>CUSTOMER_KEY_LABEL</code>. A value not recorded is empty.</p>

                            <h6>Rules</h6>
                            <ul>
                                <li>A hook runs only while enabled (executable). Exiting non-zero fails the device's run.</li>
                                <li>It must finish within <code>RPI_SB_HOOK_TIMEOUT</code> seconds, 1800 by default, or it is stopped and counted as failed.</li>
                                <li>Its output goes to the provisioner's log for the device: Services, then View Logs.</li>
                                <li>Always name the device: <code>fastboot -s "$1" ...</code>. Another board may be connected. Give each call its own limit, e.g. <code>timeout 30 fastboot -s "$1" getvar serialno</code>, because fastboot waits for ever for a device that has gone.</li>
                            </ul>

                            <details>
                                <summary>Fastboot command reference</summary>
                                <p>What the provisioning image's fastbootd accepts, as <code>fastboot -s "$1" &lt;command&gt;</code>. A command is at most 256 bytes; <code>oem</code> arguments cannot contain spaces. Files move through a staging buffer on the device: <code>stage</code> fills it from this server and <code>get_staged</code> empties it back, as the protocol's <code>download</code> and <code>upload</code>.</p>
                                <table>
                                    <tbody>
                                        <tr><td><code>getvar &lt;name&gt;</code></td><td>Read one value; <code>getvar all</code> lists them. Useful: <code>serialno</code>, <code>rpi-duid</code>, <code>product</code>, <code>revision-type</code>, <code>revision-memory</code>, <code>sdram-size-bytes</code>, <code>mac-ethernet</code>, <code>mac-wifi</code>, <code>mac-bt</code>, <code>ipv4-address</code>, <code>ipv6-address</code>, <code>mmc-cid</code>, <code>mmc-sector-count</code>, <code>block-devices</code>, <code>block-device-size:&lt;dev&gt;</code>, <code>secure</code>, <code>otp-lock-status</code>, <code>public-key</code>, <code>eeprom-sha256</code>, <code>version-bootloader</code>, <code>version-fastbootd</code>, <code>dmesg</code></td></tr>
                                        <tr><td><code>oem led &lt;LED&gt; &lt;value&gt;</code></td><td>Set a board LED, e.g. <code>oem led PWR 1</code></td></tr>
                                        <tr><td><code>oem gpioset &lt;chip&gt; &lt;line=value&gt;...</code></td><td>Drive GPIO lines, as <code>gpioset</code> does</td></tr>
                                        <tr><td><code>oem mount &lt;device&gt; &lt;dir&gt; [type]</code><br><code>oem umount &lt;dir&gt;</code></td><td>Mount a filesystem on the device, and unmount it</td></tr>
                                        <tr><td><code>stage &lt;file&gt;</code> then <code>oem download-file &lt;path&gt;</code></td><td>Put a file on the device. It overwrites the path.</td></tr>
                                        <tr><td><code>oem upload-file &lt;path&gt;</code> then <code>get_staged &lt;file&gt;</code></td><td>Fetch a file from the device</td></tr>
                                        <tr><td><code>flash &lt;partition&gt; &lt;image&gt;</code>, <code>erase &lt;partition&gt;</code></td><td>Write or wipe a partition. Destroys what was there.</td></tr>
                                        <tr><td><code>reboot</code>, <code>reboot bootloader</code></td><td>End the session; later commands will wait for the device</td></tr>
                                    </tbody>
                                </table>
                                <p><strong>Leave to the provisioner:</strong> <code>oem partinit</code>, <code>oem partapp</code>, <code>oem cryptinit</code>, <code>oem cryptopen</code>, <code>oem cryptsetpassword</code>, <code>oem idp*</code>, <code>oem veritysetup</code>, <code>oem verityappend</code>, <code>oem bmap-*</code>, <code>oem eeprom-update</code>, <code>oem eeprom-verify</code>, <code>oem eeprom-read</code> and <code>oem fwcrypto</code>. They rewrite storage, the EEPROM or keys; <code>oem fwcrypto init</code> writes to OTP and cannot be undone.</p>
                                <p><code>$1</code> always reaches the full command set: when the device splits control from data, it is the USB control connection.</p>
                            </details>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script src="/static/js/ace/ace.js"></script>
<script>
    // Ace is vendored under /static/js/ace, and nothing else is needed: the
    // page used to fetch jQuery, Ace and Font Awesome from public CDNs, so a
    // station off the internet had no editor, and code from elsewhere ran
    // with the operator's session.
    (function () {
        var area = document.getElementById('editor');
        var editor = { getValue: function () { return area.value; },
                       setValue: function (v) { area.value = v; } };
        if (window.ace) {
            ace.config.set('basePath', '/static/js/ace');
            var ed = ace.edit('ace-editor');
            ed.setTheme('ace/theme/monokai');
            ed.session.setMode('ace/mode/sh');
            // Otherwise Tab indents and never leaves: keyboard users could
            // not reach Save. Enter starts editing and Escape leaves.
            ed.setOption('enableKeyboardAccessibility', true);
            ed.setFontSize(14);
            ed.setValue(area.value, -1);
            document.getElementById('ace-editor').hidden = false;
            area.hidden = true;
            editor = { getValue: function () { return ed.getValue(); },
                       setValue: function (v) { ed.setValue(v, -1); } };
        }
        window.scriptEditor = editor;

        var scriptName = document.getElementById('script-filename').textContent;
        var scriptExists = <%c++ $$ << (script_exists ? "true" : "false"); %>;
        var activeTab = new URLSearchParams(location.search).get('activeTab') || '';
        var listUrl = '/customisation/list-scripts' +
            (activeTab ? '?activeTab=' + encodeURIComponent(activeTab) : '');

        // Say which stage this hook is, and mark its row.
        (function () {
            var stage = scriptName.replace(/^[a-z]+-provisioner-/, '').replace(/\.sh$/, '');
            var row = document.querySelector('.hook-help tr[data-stage="' + stage + '"]');
            if (!row) return;
            row.classList.add('current');
            document.getElementById('hook-help-this').textContent =
                'This hook runs at ' + stage + ', as root. Its row is highlighted below.';
        })();

        var modal = document.getElementById('helpModal');
        function showHelp(show) {
            modal.style.display = show ? 'block' : 'none';
            modal.classList.toggle('show', show);
        }
        document.getElementById('script-help-btn').addEventListener('click', function () { showHelp(true); });
        document.querySelectorAll(".close, .btn[data-dismiss='modal']").forEach(function (b) {
            b.addEventListener('click', function () { showHelp(false); });
        });

        document.querySelectorAll("a[href='/customisation/list-scripts']").forEach(function (a) {
            a.href = listUrl;
        });

        var copyBtn = document.getElementById('copy-from-btn');
        var copyMenu = document.getElementById('copy-from-menu');
        if (copyBtn && copyMenu) {
            copyBtn.addEventListener('click', function (e) {
                e.stopPropagation();
                copyMenu.classList.toggle('open');
            });
            document.addEventListener('click', function () { copyMenu.classList.remove('open'); });
            copyMenu.addEventListener('click', function (e) { e.stopPropagation(); });
            copyMenu.querySelectorAll('.copy-from-item').forEach(function (item) {
                item.addEventListener('click', function (e) {
                    e.preventDefault();
                    copyMenu.classList.remove('open');
                    var source = item.dataset.source;
                    var provisioner = item.dataset.provisioner;
                    if (!confirm("Replace current editor contents with the script from " + provisioner +
                                 "? Any unsaved changes will be lost.")) {
                        return;
                    }
                    fetch('/customisation/get-script?script=' + encodeURIComponent(source),
                          { headers: { 'Accept': 'application/json' } })
                        .then(function (r) {
                            return r.json().catch(function () { return {}; }).then(function (body) {
                                if (!r.ok) throw new Error(body.error || ('HTTP ' + r.status));
                                return body;
                            });
                        })
                        .then(function (body) {
                            if (body.content === undefined) {
                                alert("Failed to load script from " + provisioner + ": unexpected response format.");
                                return;
                            }
                            editor.setValue(body.content);
                        })
                        .catch(function (err) {
                            alert("Failed to load script from " + provisioner + ". " + err.message);
                        });
                });
            });
        }

        document.getElementById('save-btn').addEventListener('click', function () {
            var content = editor.getValue();
            if (!scriptExists && content.trim() === '') {
                content = '#!/bin/bash\n\n# Script arguments:\n# $1 - The provisioner ID (e.g., "raspios_lite_arm64")\n# $2 - The stage name (e.g., "post-flash", "rootfs-mounted")\n# $3 - The log file path (append output here with >> "$3")\n\n# Example: Modify a file in the rootfs\necho "[$1] Adding custom configuration to /etc/hosts during $2 stage" >> "$3"\n\n# Append a custom host entry to /etc/hosts in the rootfs\necho "10.0.0.100 custom-host" >> /mnt/rootfs/etc/hosts\n\n# Return success\nexit 0';
                editor.setValue(content);
            }
            var base = scriptName.endsWith('.sh') ? scriptName.slice(0, -3) : scriptName;
            fetch('/customisation/save-script', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ filename: base, content: content })
            }).then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                window.location.href = listUrl;
            }).catch(function () {
                alert("Failed to save script. Please try again.");
            });
        });
    })();
</script>
    </main>
</body>
</html> 