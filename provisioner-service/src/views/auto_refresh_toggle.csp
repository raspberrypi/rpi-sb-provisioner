<!-- Auto Refresh Toggle Partial -->
<div class="toggle-container">
    <label class="toggle-switch" for="auto-refresh">
        <input type="checkbox" id="auto-refresh" checked aria-describedby="refresh-status">
        <span class="toggle-slider" aria-hidden="true"></span>
        <span class="sr-only">Auto Refresh</span>
    </label>
    <span id="toggle-label" aria-hidden="true">Auto Refresh</span>
    <span id="refresh-status" aria-live="polite">(Enabled - refreshing every 5s)</span>
</div>

<script src="/static/js/live-update.js"></script>
<script>
    // Every five seconds while the page is visible; the refresh function is
    // told it is automatic, so it can hold back while text is selected.
    let stopPolling = null;
    const refreshToggle = document.getElementById('auto-refresh');
    const refreshStatus = document.getElementById('refresh-status');

    function startRefresh(refreshFunction, interval = 5000) {
        if (stopPolling) stopPolling();
        stopPolling = RpiLive.poll(function () { refreshFunction({ auto: true }); }, interval);
        refreshStatus.textContent = '(Enabled - refreshing every ' + interval / 1000 + 's)';
    }

    function stopRefresh() {
        if (stopPolling) stopPolling();
        stopPolling = null;
        refreshStatus.textContent = '(Disabled)';
    }

    function initAutoRefresh(refreshFunction) {
        if (refreshToggle.checked) startRefresh(refreshFunction);
        else stopRefresh();
        refreshToggle.addEventListener('change', function () {
            if (this.checked) startRefresh(refreshFunction);
            else stopRefresh();
        });
    }
</script>
