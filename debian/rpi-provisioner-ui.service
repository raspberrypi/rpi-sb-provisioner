[Unit]
Description=Raspberry Pi Secure Boot Provisioner Web UI Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/rpi-provisioner-ui
Restart=always
RestartSec=10

# The UI stays root, because it writes the configuration and hooks that the
# provisioners run as root, but it is network-facing, so it gets nothing else.
# Every file it touches is root-owned. CAP_DAC_OVERRIDE is kept as a margin
# for secret files kept at 0400, which some paths may still rewrite in place.
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=
NoNewPrivileges=yes

# /usr, /boot and /etc are read-only apart from its own configuration. /srv,
# /var and /home stay writable because RPI_SB_WORKDIR may point anywhere.
ProtectSystem=full
ReadWritePaths=/etc/rpi-sb-provisioner
PrivateTmp=yes
UMask=0027

# Firmware crypto (librpifwcrypto opens /dev/vcio and /dev/vcio_crypto) and
# HSMs, which a PKCS#11 module reaches over raw USB or hidraw when it does
# not go through pcscd. Everything else, block devices included, is closed.
DevicePolicy=closed
DeviceAllow=/dev/vcio rw
DeviceAllow=/dev/vcio_crypto rw
DeviceAllow=char-usb_device rw
DeviceAllow=char-hidraw rw

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
# Netlink for the udev monitor; Unix for D-Bus and the journal.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
