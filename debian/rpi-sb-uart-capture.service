[Unit]
Description=Raspberry Pi provisioner: capture the serial console of each jig head
Documentation=file:///usr/share/rpi-sb-provisioner/uart.d/README

[Service]
Type=simple
ExecStart=/usr/bin/rpi-sb-uart-capture
# It exits cleanly when uart.d maps no port, and is restarted when it changes.
Restart=on-failure
RestartSec=5

# Reads UARTs and writes logs, as root, with nothing else. It never writes to
# a UART: the host's TX reaches the board's console.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
DevicePolicy=closed
DeviceAllow=char-ttyAMA r
DeviceAllow=char-ttyS r
DeviceAllow=char-ttyUSB r
DeviceAllow=char-ttyACM r
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
