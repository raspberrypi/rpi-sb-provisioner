[Unit]
Description=Bootstrap a Raspberry Pi device in to Fastboot, for full-disk encryption setup
After=%i.device

[Service]
Type=notify
ExecStart=/usr/bin/rpi-sb-bootstrap.sh /%I
# '/' is needed - otherwise triage does not use correct address of device
EnvironmentFile=/usr/share/rpi-sb-provisioner/defaults/config
EnvironmentFile=-/etc/rpi-sb-provisioner/config
# Backstop for any hang the script's own timeouts miss; override with a drop-in.
RuntimeMaxSec=1h

# Tier A hardening: nothing here creates a namespace or restricts devices,
# because provisioning needs loop devices, mounts and raw USB, and operator
# hooks may need anything else root can do. Only what no step uses is removed.
NoNewPrivileges=yes
CapabilityBoundingSet=~CAP_SYS_MODULE CAP_SYS_BOOT CAP_SYS_TIME CAP_WAKE_ALARM CAP_SYS_PTRACE CAP_SYSLOG CAP_BPF CAP_PERFMON CAP_SYS_PACCT CAP_SYS_TTY_CONFIG CAP_LEASE CAP_BLOCK_SUSPEND CAP_MAC_ADMIN CAP_MAC_OVERRIDE CAP_AUDIT_CONTROL CAP_AUDIT_READ CAP_CHECKPOINT_RESTORE
LockPersonality=yes
RestrictRealtime=yes
ProtectHostname=yes
SystemCallArchitectures=native
SystemCallFilter=~@clock @module @reboot @swap @cpu-emulation @obsolete
SystemCallErrorNumber=EPERM
